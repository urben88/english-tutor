{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "excalidraw": {
      "command": "node",
      "args": [
        "ai-frontend-guide-kit/tools/excalidraw-mcp.mjs",
